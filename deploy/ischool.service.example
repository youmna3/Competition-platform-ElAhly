[Unit]
Description=iSchool Al Ahly Judging Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ischool
Group=ischool
WorkingDirectory=/srv/ischool/current/server
Environment=NODE_ENV=production
EnvironmentFile=/etc/ischool/application.env
ExecStart=/opt/node24/bin/node /srv/ischool/current/server/dist/src/index.js --production
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ischool

[Install]
WantedBy=multi-user.target
