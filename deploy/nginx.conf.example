# Replace the domain and certificate paths. Keep Node inaccessible from the Internet.
server {
    listen 80;
    server_name judging.example.com;
    return 301 https://judging.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name judging.example.com;
    ssl_certificate /etc/letsencrypt/live/judging.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/judging.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host judging.example.com;
        # Overwrite forwarded headers; never trust client-supplied values.
        proxy_set_header X-Forwarded-Host judging.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }
}
