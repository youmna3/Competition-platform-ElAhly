# Inject real values through the service's protected environment/secret store.
# Never ship a filled-in copy in an archive or commit it.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
ALLOW_NETWORK_ACCESS=false
PUBLIC_ORIGIN=https://judging.example.com
TRUST_PROXY=loopback
# Same-origin hosting is recommended. Blank disables additional CORS origins.
CORS_ORIGINS=
COOKIE_SECURE=true
SESSION_SECRET=
SESSION_IDLE_MINUTES=240
SESSION_MAX_HOURS=12
LOGIN_RATE_LIMIT=20
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=judging_platform
DB_USER=judging_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Required for databases on another host; use a trusted provider CA file.
DB_TLS=false
DB_TLS_CA_FILE=
# Do not give the normal application process database-administrator credentials.
MAINTENANCE_API_ENABLED=false
COMPETITION_RESET_ENABLED=false
# Supply only in the separate maintenance session, never in the public web process.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_APP_USER=judging_app
DB_APP_PASSWORD=
ADMIN_EMAIL=youmna54@gmail.com
ADMIN_FULL_NAME=Administrator
ADMIN_INITIAL_PASSWORD=
MYSQL_BIN_DIR=
BACKUP_DIR=
