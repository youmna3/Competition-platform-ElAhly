# Copy this file to server/.env and adjust it. Never commit server/.env.

# ---------- runtime ----------
NODE_ENV=development
# 127.0.0.1 keeps the API reachable from this computer only.
HOST=127.0.0.1
PORT=4000
# Must stay false until HTTPS and the firewall rule are set up (Phase 10).
ALLOW_NETWORK_ACCESS=false

# ---------- XAMPP MySQL / MariaDB ----------
DB_HOST=127.0.0.1
DB_PORT=3306
# Phase 0 can use XAMPP's default root account. Phase 1 creates a dedicated
# least-privilege user (judging_app) and you switch to it here.
DB_USER=root
DB_PASSWORD=
DB_NAME=judging_platform
DB_CONNECTION_LIMIT=10

# ---------- database tools (migrations, seed, backups) ----------
# Account used by db:setup, db:migrate, db:backup and db:restore.
# Leave empty to use DB_USER / DB_PASSWORD (fine while DB_USER is root).
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
# Least-privilege account for the running API, created by: npm run db:app-user
DB_APP_USER=judging_app
DB_APP_PASSWORD=
# Folder with mysqldump.exe and mysql.exe. Empty = C:\xampp\mysql\bin when it exists.
MYSQL_BIN_DIR=
# Where backups are written (relative to the server folder). Default: ../backups
BACKUP_DIR=

# ---------- first administrator (used once by db:setup / db:seed) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrator
# Leave empty to have a strong temporary password generated and shown once.
# If you set one, it must meet the password policy; remove it after first sign-in.
ADMIN_INITIAL_PASSWORD=

# ---------- sign-in and sessions ----------
# Signs the session cookie. Fill it with:  npm run auth:secret  (never share it;
# changing it signs everyone out). The API refuses to start without it.
SESSION_SECRET=
# A session ends after this many minutes without activity ...
SESSION_IDLE_MINUTES=240
# ... and always after this many hours, even if active.
SESSION_MAX_HOURS=12
# Set to true only once the app is served over HTTPS (later phase).
COOKIE_SECURE=false
# Failed sign-ins allowed per device (IP address) per 15 minutes.
LOGIN_RATE_LIMIT=20
# Consecutive wrong passwords before an account is locked, and for how long.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Competition reset execution stays disabled until the owner approves a backup/preview.
# Prefer a temporary process variable for approved maintenance; never enable by default.
COMPETITION_RESET_ENABLED=true
