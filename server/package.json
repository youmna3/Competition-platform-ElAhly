{
  "name": "@judging/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js --production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:rubric-check": "tsx scripts/db-rubric-check.ts",
    "db:create": "tsx scripts/db-create.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:app-user": "tsx scripts/db-app-user.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:restore-check": "tsx scripts/db-restore-check.ts",
    "db:demo": "tsx scripts/db-demo.ts",
    "demo:dev": "tsx scripts/demo-dev.ts",
    "auth:secret": "tsx scripts/auth-secret.ts",
    "auth:reset-password": "tsx scripts/auth-reset-password.ts",
    "production:migrate": "node dist/scripts/db-migrate.js",
    "production:backup": "node dist/scripts/db-backup.js",
    "production:restore": "node dist/scripts/db-restore.js",
    "production:restore-check": "node dist/scripts/db-restore-check.js",
    "production:check": "node dist/scripts/db-check.js",
    "production:create": "node dist/scripts/db-create.js",
    "production:seed": "node dist/scripts/db-seed.js",
    "production:app-user": "node dist/scripts/db-app-user.js"
  },
  "dependencies": {
    "@judging/shared": "0.1.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.9.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "vitest": "^4.1.12"
  }
}
